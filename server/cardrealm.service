[Unit]
Description=Card Realm online relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardrealm
Group=cardrealm
WorkingDirectory=/opt/cardrealm
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=MAX_ROOMS=500
ExecStart=/usr/bin/python3 /opt/cardrealm/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
